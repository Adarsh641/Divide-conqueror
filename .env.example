# Divide & Rule — Production & Development Environment Variables

# Server Port (assigned by hosting platforms like Render, Railway, Heroku automatically)
PORT=5001

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/divide_and_rule?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/divide_and_rule?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong 32+ character key for production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Environment mode ('development' or 'production')
NODE_ENV=production
