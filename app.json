{
  "expo": {
    "name": "Divide & Rule",
    "slug": "divide-and-rule",
    "owner": "adarsh76777",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#051B14",
    "splash": {
      "backgroundColor": "#051B14",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adarsh.divideandrule"
    },
    "android": {
      "package": "com.adarsh.divideandrule",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#051B14"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98b08277-7d2f-4f37-8efc-2450195f7d4f"
      }
    }
  }
}
